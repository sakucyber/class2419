{
  "name": "class2419",
  "compatibility_date": "2026-10-13",
  // ⚠️ 这是「Workers 静态资源」部署用的配置。
  // Workers 静态资源同样不处理 Range（视频进度条拖不动），行为与 Cloudflare Pages 一致：
  // 站点会走 VideoDetailView 里的客户端 Blob 兜底（整段预载后换源），不需要 Worker。
  // 若以后想要原生 206 / 边下边拖，把视频迁到 R2 / Stream 等支持 Range 的存储，详见 README。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
