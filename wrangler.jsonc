{
  "name": "class2419",
  "compatibility_date": "2026-10-13",
  // ⚠️ 这是「Workers 静态资源」部署用的配置，functions/ 目录只对 Cloudflare Pages 生效。
  // Workers 静态资源同样不处理 Range（视频进度条拖不动）；若要用这条路径部署，
  // 需要 assets.run_worker_first + 复用 functions/videos/[[path]].js 的切片逻辑，详见 README。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
